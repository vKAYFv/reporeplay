PORT=3000
HOST=0.0.0.0
REDIS_URL=redis://redis:6379

COUNT_MODE=unique
COUNT_BOTS=false
UNIQUE_VIEW_TTL_SECONDS=86400
VIEW_COOLDOWN_SECONDS=300
UNIQUE_HASH_SECRET=replace-this-with-at-least-16-random-characters

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_PER_MINUTE=100
RATE_LIMIT_GLOBAL_PER_MINUTE=10000

ADMIN_API_KEY=replace-this-with-a-long-random-api-key
LOG_LEVEL=info
ALLOW_TEST_VISITOR_HEADER=false
